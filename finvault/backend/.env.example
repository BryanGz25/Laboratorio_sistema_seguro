# Copia este archivo a .env y reemplaza TODOS los valores. Nunca lo subas al repositorio.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://finvault:CAMBIAR@localhost:5432/finvault
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_DE_MAS_DE_32_CARACTERES
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CAMBIAR_POR_32_BYTES_EN_BASE64
GOOGLE_CLIENT_ID=
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MAX_ACCOUNTS_PER_USER=10
# Opcional para el correo de recuperación. Ej.: smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=
MAIL_FROM=FinVault <no-reply@finvault.local>
